{
  "name": "preflight-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "PreFlight AI - Production readiness gatekeeper for software projects",
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "tsc --build --clean && tsc --build tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "format": "tsc --noEmit",
    "temp:vulnerable": "node scripts/temp-vulnerable.mjs",
    "temp:clean": "node scripts/temp-vulnerable.mjs --clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "vitest.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dimple2906/PreFlight-AI.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "types": "./vitest.config.d.ts",
  "bugs": {
    "url": "https://github.com/Dimple2906/PreFlight-AI/issues"
  },
  "homepage": "https://github.com/Dimple2906/PreFlight-AI#readme"
}
