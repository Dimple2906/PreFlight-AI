    "typecheck": "tsc --noEmit",
    "start": "node ./bin/preflight.js"
  },
  "license": "MIT",
  "author": "PreFlight AI Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/preflight-ai/preflight.git"
  },
  "keywords": [
    "preflight",
    "preflight-ai",
    "cli",
    "production-readiness",
    "testing",
    "deployment",
    "qa",
    "gatekeeper",
    "security"
  ],
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "ora": "^8.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@preflight/ai-engine": "workspace:*",
