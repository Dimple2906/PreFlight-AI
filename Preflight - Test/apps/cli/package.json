{
  "name": "preflight-ai",
  "version": "1.0.0",
  "description": "PreFlight AI - CLI Production Readiness Gatekeeper for Software Projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "preflight": "./bin/preflight.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
