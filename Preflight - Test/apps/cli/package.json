    "@preflight/config": "workspace:*",
    "@preflight/core": "workspace:*",
    "@preflight/deploy-engine": "workspace:*",
    "@preflight/discovery": "workspace:*",
    "@preflight/qa-engine": "workspace:*",
    "@preflight/reporter": "workspace:*",
    "@preflight/security": "workspace:*",
    "@types/node": "^22.13.5",
