# PreFlight AI Configuration
# Safe environment template (NO real API keys should ever be committed)

# Gemini API Key (Optional: enables Gemini adaptive reasoning layer)
GEMINI_API_KEY=your_gemini_api_key_here

# PreFlight AI Provider (gemini | mock)
PREFLIGHT_AI_PROVIDER=gemini

# Default Log Level (silent | normal | verbose | debug)
PREFLIGHT_LOG_LEVEL=normal
